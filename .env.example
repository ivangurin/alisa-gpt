# Скопируйте в .env и подставьте свои значения.
# На VPS переменные передаются через -e в docker run; здесь указаны дефолты.

# --- Обязательное ---
OPENAI_API_KEY=sk-...

# --- Сервер ---
APP_HOST=0.0.0.0
APP_PORT=8080
HTTP_TIMEOUT=30

# --- Логи ---
LOG_LEVEL=info
LOG_FORMAT=dev

# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=300
# Лимит Алисы на ответ вебхука — 4.5 c; таймаут держит запас на транспорт.
OPENAI_TIMEOUT_MS=3500
# Дефолт: краткий голосовой собеседник без markdown (см. internal/config).
# OPENAI_SYSTEM_PROMPT=...

# --- Диалог ---
# Дефолты фраз — в internal/config; переопределение при желании:
# DIALOG_WELCOME=...
# DIALOG_FALLBACK=...
DIALOG_MAX_CHARS=1000

# --- История диалога ---
HISTORY_LIMIT=20
HISTORY_TTL=30m
